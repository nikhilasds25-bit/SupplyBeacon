# Default deny: only reviewed runtime inputs enter the build context.
**
!Dockerfile
!.dockerignore
!requirements-api.lock
!data/
!data/graph/
!data/graph/supply_chain_graph.graphml
!data/graph/nodes.csv
!data/graph/edges.csv
!data/gnn_prediction/
!data/gnn_prediction/node_embeddings.csv
!data/processed/
!data/processed/brand_supplier_mapping.csv
!data/processed/electronics_supplychain_dataset.csv
!data/risk_prediction/
!data/risk_prediction/risk_scores.csv
!deploy/
!deploy/start.py
!deploy/audit_seed.py
!deploy/seed-manifest.json
!deploy/seed/
!deploy/seed/analysis/
!deploy/seed/analysis/dataco/
!deploy/seed/analysis/dataco/modeling/
!deploy/seed/analysis/dataco/modeling/baseline_metrics.csv
!deploy/seed/analysis/dataco/modeling/feature_audit.json
!deploy/seed/analysis/dataco/modeling/run_summary.json
!deploy/seed/current/
!deploy/seed/current/current_business_impacts.csv
!deploy/seed/current/current_events.json
!deploy/seed/current/current_risk_scores.csv
!deploy/seed/current/current_run_metadata.json
!deploy/seed/current/current_supply_chain_graph.graphml
!deploy/seed/current/current_weather.json
!src/
!src/**/
!src/**/*.py
# Defense in depth below allowed source directories.
**/__pycache__/
**/*.pyc
**/*.pyo
**/.env*
**/*.db
**/*.db-*
**/*.pem
**/*.key
