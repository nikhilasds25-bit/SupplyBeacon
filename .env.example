# Required for protected refresh; if absent, refresh fails closed.
SUPPLYBEACON_ADMIN_API_KEY=

# Provider keys are not needed for the seeded read-only demo. Set only if
# protected external refresh is intentionally configured later.
NEWS_API_KEY=
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=

# Optional LLM configuration; keep disabled for the public demo.
SUPPLYBEACON_LLM_ENABLED=false
ELECTROGRAPH_LLM_API_KEY=
ELECTROGRAPH_LLM_BASE_URL=
ELECTROGRAPH_LLM_MODEL=

# Required public-demo backend configuration. Use localhost origins only
# for local development if needed; do not enable public master-data writes.
SUPPLYBEACON_ALLOWED_ORIGINS=https://supply-beacon.vercel.app
SUPPLYBEACON_MASTER_WRITE_ENABLED=false

# Persistent Railway volume paths (mount /app/data/persistent first).
# SUPPLYBEACON_CURRENT_DATA_DIR=/app/data/persistent/current
# SUPPLYBEACON_MASTER_DB_PATH=/app/data/persistent/master/supplybeacon_master.db
# SUPPLYBEACON_MASTER_GENERATED_DIR=/app/data/persistent/master/generated

# Frontend build-time configuration. Development uses /api through the Vite
# proxy; set VITE_DEV_API_TARGET only when the local backend uses another URL.
VITE_DEV_API_TARGET=http://127.0.0.1:8780
# Set this in deployments only when the frontend and API use different origins.
VITE_API_BASE_URL=
